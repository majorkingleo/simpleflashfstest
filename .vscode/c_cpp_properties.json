{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/cpputils/cpputilsshared",
                "${workspaceFolder}/cpputils/cpputilsshared/cpputilsformat",
                "${workspaceFolder}/cpputils/io",
                "${workspaceFolder}/common",
                "${workspaceFolder}/simpleflashfs/src",
                "${workspaceFolder}/simpleflashfs/src/dynamic",
                "${workspaceFolder}/simpleflashfs/src/static",
                "${workspaceFolder}/simpleflashfs/src/sim_pc",
                "${workspaceFolder}/simpleflashfs/src/crc",
                "${workspaceFolder}/simpleflashfs/src/base",
                "${workspaceFolder}/simpleflashfs/src_vfs",
                "${workspaceFolder}/simpleflashfs/src_2face",
                "${default}"
            ],
            "defines": [
                "_GLIBCXX_USE_CXX11_ABI=1",
                "_XOPEN_SOURCE=700"
            ],
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerPath": "/usr/bin/g++"
        }
    ],
    "version": 4
}
